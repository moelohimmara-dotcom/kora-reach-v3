# kora-reach.service — systemd unit (bulletproof)
# Install : cp kora-reach.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now kora-reach
[Unit]
Description=KORA Reach — agent de collecte + HITL éditorial
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=kora
Group=kora
WorkingDirectory=/opt/kora-reach
EnvironmentFile=/opt/kora-reach/deploy/.env
Environment=PORT=8766
ExecStart=/opt/kora-reach/.venv/bin/python /opt/kora-reach/server.py
# Toujours relancer : crash, OOM, kill, ou sortie inattendue.
Restart=always
RestartSec=3
# Pas de limite de tentatives (StartLimitIntervalSec=0) : on ne veut jamais
# que le service reste mort après N échecs.
# --- Durcissement ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kora-reach
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
# Pas d'accès sauf réseau + fichiers du projet
# (on autorise le réseau car l'agent collecte des flux externes)
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
