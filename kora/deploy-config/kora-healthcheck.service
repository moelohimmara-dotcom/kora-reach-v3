# kora-healthcheck.service — watchdog oneshot (lancé par kora-healthcheck.timer)
# Vérifie que l'API répond ; sinon relance kora-reach.
[Unit]
Description=KORA Reach — healthcheck et auto-relance
After=kora-reach.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'if ! curl -fsS --max-time 5 http://127.0.0.1:8766/api/health >/dev/null 2>&1; then echo "$(date -Is) KORA health KO -> restart"; systemctl restart kora-reach; fi'
