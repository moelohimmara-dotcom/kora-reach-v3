# ============================================================
# kora/ — dossier de preuves, prototypes, scripts de diagnostic et logs
# (le code source de KORA reste à la racine du repo, pas ici)
# ============================================================

# --- SECRETS / CREDENTIALS (JAMAIS versionnés) ---
.env
.env.*
_key.txt
**/_key.txt
*.secret
*.token

# --- Fichiers binaires volumineux / core dumps (refusés par GitHub >100 Mo) ---
core.*
*.core
*.dmp

# --- Build front + deps (déjà ignorés à la racine, redondance ici) ---
dist/
node_modules/
.venv/
__pycache__/
*.pyc

# --- Données / DB ---
*.db
*.sqlite
*.sqlite3
backups/

# --- Logs runtime volumineux (on garde auth_audit.log léger, mais on exclut les gros) ---
*.log
!logs/auth_audit.log

# --- OS / éditeur ---
.DS_Store
Thumbs.db
*.swp
