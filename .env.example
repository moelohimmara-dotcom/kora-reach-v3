# =============================================================================
# KORA Reach — exemple de fichier d'environnement
# -----------------------------------------------------------------------------
# Copier en `.env` et renseigner les VRAIES valeurs (jamais committées).
# Le fichier réel vit sur le VPS dans : /opt/kora-reach/deploy/.env
# et est chargé par le service systemd (EnvironmentFile=).
# Aucune de ces valeurs ne doit apparaitre en clair dans le repo ou les logs.
# =============================================================================

# --- Compte administrateur de l'app (interface /api/auth/login) ---
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_admin_password
ADMIN_EMAIL=admin@example.com

# --- Compte ROOT de la console système (12.1-12.5) — SÉPARÉ des comptes
# éditeurs ci-dessus : table/sessions/cookie dédiés (root_auth.py), 2FA
# obligatoire dès la 1ère connexion. Console à /root-console (non liée
# dans l'UI normale). Si non défini : aucun compte root créé, console
# inaccessible (fail-closed, pas de compte par défaut).
ROOT_USER=CHANGE_ME_root_username
ROOT_PASS=CHANGE_ME_root_password
ROOT_EMAIL=root@example.com

# --- Base de donnees Postgres (backend lit PG_PASSWORD, host/user/db par defaut) ---
# Host/port/user/db par defaut cotes cote serveur : 127.0.0.1:5432 / kora / kora
PG_PASSWORD=CHANGE_ME_postgres_password

# --- Backend ---
DATABASE_BACKEND=postgres
KORA_HTTPS=1                      # 1 = TLS (nginx termine le TLS), 0 = HTTP seul
KORA_PUBLIC_HOST=213.156.135.139.sslip.io

# --- LLM / illustration ---
NVIDIA_API_KEY=CHANGE_ME_nvidia_api_key
OLLAMA_API_KEY=CHANGE_ME_ollama_key   # vide si Ollama local sans auth
OLLAMA_MODEL=CHANGE_ME_ollama_model   # ex: llama3.1:8b

# --- Traduction / services tiers ---
TR_KEY=CHANGE_ME_translation_api_key
