# .env.example — KORA Reach (NE PAS COMMITTER, JAMAIS DE VALEURS RÉELLES)
# Copier en .env et remplir avec les VRAIES valeurs côté VPS (variables d'env uniquement).
# Aucune credential ne doit figurer dans le code ou le repo git.
# Toutes les variables lues par le code (os.environ.get) sont listées ici.

# --- Réseau / serveur (stdlib http.server) ---
PORT=8766
BIND=127.0.0.1            # nginx fait le reverse proxy (jamais exposer le port direct)
KORA_STATIC=./kora-vite/dist   # dossier du front-build servi en statique
KORA_ALLOWED_ORIGIN=https://213-156-135-139.sslip.io
KORA_API_TOKEN=           # token optionnel pour sécuriser l'API (laisser vide si non utilisé)

# --- Base de données ---
# DATABASE_BACKEND=postgres (prod) | sqlite (dev local, si supporté)
DATABASE_BACKEND=postgres
DATABASE_URL=              # optionnel : URL complète postgres://user:pass@host:port/db
# Sinon, variables PG individuelles (prioritaires si DATABASE_URL absent) :
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=kora
PG_USER=kora
PG_PASSWORD=               # SECRET — requis pour PostgreSQL (sinon RuntimeError au boot)

# --- Auth (PBKDF2-SHA256) ---
ADMIN_USER=admin
ADMIN_PASS=                # SECRET — mot de passe admin initial (voir aussi deploy/.env ADMIN_PASS)
ADMIN_EMAIL=admin@kora.local
KORA_HTTPS=1               # 1 = cookie Secure activé
KORA_PBKDF2_ROUNDS=200000
KORA_SESSION_TTL_H=24
KORA_RL_MAX=20             # tentatives login / fenêtre (rate-limit par IP)
KORA_RL_WINDOW=600         # fenêtre en secondes
KORA_RESET_TTL_MIN=30      # TTL lien de reset mot de passe
KORA_AUTH_LOG=0            # 1 = log détaillé auth

# --- Éditeur HITL ---
EDITOR_NAME=chef_de_secteur

# --- SMTP (emails de reset mot de passe) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                 # SECRET
SMTP_FROM=no-reply@kora.local

# --- Supabase (écriture articles validés HITL) ---
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=sb_secret_XXXXXXXXXXXXXXXX   # service_role — SECRET, rotation obligatoire

# --- WordPress (publication après validation HITL) ---
WP_URL=https://kakilambe.com
WP_USER=harvingt
WP_APP_PASS=XXXX XXXX XXXX XXXX XXXX      # mot de passe applicatif WP — SECRET

# --- Images de couverture (2026-08-21 : aucune génération IA -- retrait de
# FAL et Pollinations. L'image de couverture est TOUJOURS une vraie photo :
# priorité aux images des sources du cluster (champion/contexts), repli sur
# une photo stock réelle (LoremFlickr/Picsum) si aucune source n'en a. Aucune
# variable d'environnement à configurer pour ce mécanisme.) ---

# --- LLM (optionnel, sinon fallback template) ---
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
TR_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
