[Unit]
Description=KORA Reach — preview front-end v2 (port 8766)
After=network.target

[Service]
User=kora
Group=kora
WorkingDirectory=/opt/kora-reach
Environment=PORT=8766
Environment=KORA_STATIC=/opt/kora-reach/static-v2
EnvironmentFile=/opt/kora-reach/deploy/.env
ExecStart=/opt/kora-reach/.venv/bin/python /opt/kora-reach/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kora-reach
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
